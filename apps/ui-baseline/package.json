{
  "name": "@hmcts/ui-baseline-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Runs tools/ui-baseline's parity checks for testers, in the test environment only",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe ."
  },
  "dependencies": {
    "@hmcts-cft/cloud-native-platform": "2.3.0",
    "@hmcts/ui-baseline": "workspace:*",
    "express": "5.2.1",
    "govuk-frontend": "6.2.0",
    "nunjucks": "3.2.4",
    "openid-client": "6.8.5",
    "tsx": "4.22.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.4",
    "@types/nunjucks": "3.2.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "vitest": "4.1.10"
  }
}
