{% extends "govuk/template.njk" %}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}

{% block pageTitle %}{{ title }} – CaTH parity check{% endblock %}

{% block head %}
  <link rel="stylesheet" href="/assets/govuk-frontend.min.css">
  <link rel="stylesheet" href="/app.css">
{% endblock %}

{% block header %}
  {{ govukServiceNavigation({
    serviceName: "CaTH parity check (" + environment + ")",
    serviceUrl: "/",
    navigation: [{ href: "/sign-out", text: "Sign out" }] if user else []
  }) }}
{% endblock %}

{% block content %}{% block page_content %}{% endblock %}{% endblock %}

{% block bodyEnd %}
  <script type="module" src="/assets/govuk-frontend.min.js"></script>
  <script type="module">import { initAll } from "/assets/govuk-frontend.min.js"; initAll();</script>
{% endblock %}
