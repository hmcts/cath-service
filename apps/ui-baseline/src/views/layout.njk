{#
  The app's pages. A page sets title, and currentPage ("home" or "result") for the navigation.
#}
{% extends "page.njk" %}

{% set serviceName = "Court and tribunal hearings: UI baseline (" + environment + ")" %}
{% set serviceUrl = "/" %}
{% set navigation = [
  { text: "Home", href: "/", active: currentPage == "home", ariaCurrent: "page" },
  { text: "Result", href: "/runs/" + run.id, active: true, ariaCurrent: "page" } if currentPage == "result" and run
] %}

{% block pageTitle %}{{ title }} – Court and tribunal hearings: UI baseline{% endblock %}

{% block head %}
  <link rel="stylesheet" href="/assets/govuk-frontend.min.css">
  <link rel="stylesheet" href="/navigation.css">
  <link rel="stylesheet" href="/app.css">
{% endblock %}

{% block content %}{% block page_content %}{% endblock %}{% endblock %}

{% block bodyEnd %}
  <script type="module" src="/assets/govuk-frontend.min.js"></script>
  <script type="module">import { initAll } from "/assets/govuk-frontend.min.js"; initAll();</script>
  <script src="/navigation.js"></script>
{% endblock %}
