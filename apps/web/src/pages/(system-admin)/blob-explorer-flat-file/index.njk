{% extends "layouts/base-template.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">

    <h1 class="govuk-heading-xl">{{ header }}</h1>

    {% if error %}
      {{ govukErrorSummary({
        titleText: "There is a problem",
        errorList: [
          {
            text: error
          }
        ]
      }) }}
    {% else %}

      <form method="post" novalidate>
        {{ govukButton({
          text: flatFileResubmitButton,
          classes: "govuk-button"
        }) }}
      </form>

      <h2 class="govuk-heading-m govuk-!-margin-top-6">{{ flatFileMetadataHeading }}</h2>

      {{ govukSummaryList({
        rows: [
          {
            key: { text: metadataArtefactId },
            value: { text: metadata.artefactId }
          },
          {
            key: { text: metadataLocationId },
            value: { text: metadata.locationId }
          },
          {
            key: { text: metadataLocationName },
            value: { text: metadata.locationName }
          },
          {
            key: { text: metadataPublicationType },
            value: { text: metadata.publicationType }
          },
          {
            key: { text: metadataListType },
            value: { text: metadata.listType }
          },
          {
            key: { text: metadataProvenance },
            value: { text: metadata.provenance }
          },
          {
            key: { text: metadataLanguage },
            value: { text: metadata.language }
          },
          {
            key: { text: metadataSensitivity },
            value: { text: metadata.sensitivity }
          },
          {
            key: { text: metadataContentDate },
            value: { text: formatDateTime(metadata.contentDate) }
          },
          {
            key: { text: metadataDisplayFrom },
            value: { text: formatDateTime(metadata.displayFrom) }
          },
          {
            key: { text: metadataDisplayTo },
            value: { text: formatDateTime(metadata.displayTo) }
          }
        ]
      }) }}

      {% if flatFileUrl %}
        <p class="govuk-body govuk-!-margin-top-4">
          <a href="{{ flatFileUrl }}" class="govuk-link">{{ flatFileLinkToFile }}</a>
        </p>
      {% endif %}

    {% endif %}

  </div>
</div>
{% endblock %}
