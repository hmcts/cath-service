{% extends "layouts/base-template.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}

{% block backLink %}
  {{ govukBackLink({
    text: back,
    href: backLink
  }) }}
{% endblock %}

{% block page_content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <h1 class="govuk-heading-l">{{ title }}</h1>
  </div>
</div>

<div class="govuk-grid-row">
  {% for option in options %}
    <div class="govuk-grid-column-one-half">
      <div class="admin-tile">
        <h2 class="admin-tile__heading">
          <a href="{{ option.href }}" class="govuk-link govuk-link--no-visited-state admin-tile__link">{{ option.label }}</a>
        </h2>
        <p class="admin-tile__description">{{ option.description }}</p>
      </div>
    </div>
  {% endfor %}
</div>
{% endblock %}
