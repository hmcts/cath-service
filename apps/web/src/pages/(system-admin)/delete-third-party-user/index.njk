{% extends "layouts/base-template.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% macro getError(errors, fieldId) -%}
  {%- if errors -%}
    {%- for error in errors -%}
      {%- if error.href == fieldId -%}{{ error.text }}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endmacro %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if errors %}
      {{ govukErrorSummary({
        titleText: errorSummaryTitle,
        errorList: errors
      }) }}
    {% endif %}

    <form method="post" novalidate>

      {% set confirmDeleteErrorText = getError(errors, "#confirm-delete") %}
      {{ govukRadios({
        idPrefix: "confirm-delete",
        name: "confirmDelete",
        fieldset: {
          legend: {
            text: pageTitle ~ " " ~ userName ~ "?",
            isPageHeading: true,
            classes: "govuk-fieldset__legend--xl"
          }
        },
        errorMessage: { text: confirmDeleteErrorText } if confirmDeleteErrorText and confirmDeleteErrorText | length > 0 else undefined,
        items: [
          {
            value: "yes",
            text: yesOption
          },
          {
            value: "no",
            text: noOption
          }
        ]
      }) }}

      {{ govukButton({
        text: continueButtonText
      }) }}
    </form>

  </div>
</div>
{% endblock %}
