{% extends "layouts/base-template.njk" %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}

{% block backLink %}
  {# No back link on success page #}
{% endblock %}

{% block page_content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {{ govukPanel({
      titleText: title,
      text: body
    }) }}

    <h2 class="govuk-heading-m">{{ t.nextStepsHeading }}</h2>

    <ul class="govuk-list">
      <li>
        <a href="/manage-list-types" class="govuk-link">{{ t.manageListTypesLink }}</a>
      </li>
      <li>
        <a href="/system-admin-dashboard" class="govuk-link">{{ t.returnLink }}</a>
      </li>
    </ul>

  </div>
</div>
{% endblock %}
