{% extends "layouts/base-template.njk" %}

{% block pageTitle %}
  {{ pageTitle }} - {{ serviceName }} - {{ govUk }}
{% endblock %}

{% block page_content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <h1 class="govuk-heading-l">{{ title }}</h1>

    <div class="verified-tiles-container">
      <div class="verified-tile">
        <h2 class="govuk-heading-s verified-tile-heading">
          <a href="/search" class="govuk-link govuk-link--no-visited-state verified-tile__link">{{ sections.courtHearings.title }}</a>
        </h2>
        <p class="govuk-body verified-tile-description">
          {{ sections.courtHearings.description }}
        </p>
      </div>

      <div class="verified-tile">
        <h2 class="govuk-heading-s verified-tile-heading">
          <a href="/summary-of-publications?locationId=9" class="govuk-link govuk-link--no-visited-state verified-tile__link">{{ sections.sjpCases.title }}</a>
        </h2>
        <p class="govuk-body verified-tile-description">
          {{ sections.sjpCases.description }}
        </p>
      </div>

      <div class="verified-tile">
        <h2 class="govuk-heading-s verified-tile-heading">
          <a href="/subscription-management" class="govuk-link govuk-link--no-visited-state verified-tile__link">{{ sections.emailSubscriptions.title }}</a>
        </h2>
        <p class="govuk-body verified-tile-description">
          {{ sections.emailSubscriptions.description }}
        </p>
      </div>
    </div>
  </div>
</div>
{% endblock %}
