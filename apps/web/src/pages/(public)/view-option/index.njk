{% extends "layouts/base-template.njk" %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block page_content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if errors %}
      {{ govukErrorSummary({
        titleText: errorSummaryTitle,
        errorList: errors
      }) }}
    {% endif %}

    {% set viewOptions = [
      {
        value: "court-tribunal",
        html: courtTribunalLabel,
        hint: {
          text: courtTribunalHint
        }
      },
      {
        value: "sjp-case",
        html: sjpCaseLabel,
        hint: {
          text: sjpCaseHint
        }
      }
    ] %}
    {% if isCaseSearchEnabled %}
      {% set viewOptions = viewOptions.concat([{
        value: "case-search",
        html: caseSearchLabel,
        hint: {
          text: caseSearchHint
        }
      }]) %}
    {% endif %}

    <form method="post" novalidate>
      <div class="govuk-form-group{% if errors %} govuk-form-group--error{% endif %}">
        {{ govukRadios({
          name: "viewOption",
          fieldset: {
            legend: {
              text: title,
              isPageHeading: true,
              classes: "govuk-fieldset__legend--l"
            }
          },
          items: viewOptions
        }) }}
      </div>

      {{ govukButton({
        text: continueButton
      }) }}
    </form>

  </div>
</div>
{% endblock %}
