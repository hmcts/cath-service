{% extends "layouts/base-template.njk" %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block page_content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if errors %}
      {{ govukErrorSummary({
        titleText: errorSummaryTitle,
        errorList: errors,
        attributes: {
          tabindex: "-1"
        }
      }) }}
    {% endif %}

    <form method="post" novalidate>
      {{ govukRadios({
        name: "accountType",
        fieldset: {
          legend: {
            text: title,
            isPageHeading: true,
            classes: "govuk-fieldset__legend--l"
          }
        },
        items: [
          {
            value: "hmcts",
            text: hmctsLabel,
            checked: data.accountType == "hmcts" if data else false
          },
          {
            value: "common-platform",
            text: commonPlatformLabel,
            checked: data.accountType == "common-platform" if data else false
          },
          {
            value: "cath",
            text: cathLabel,
            checked: data.accountType == "cath" if data else false
          }
        ],
        errorMessage: {
          text: errorMessage
        } if errors else undefined
      }) }}

      {{ govukButton({
        text: continueButton
      }) }}
    </form>

    {# Typography matches the reference page, where all three lines render at
       16px: the prompt and notice via govuk-body-s, and the link because it is a
       bare <a> and govuk-link sets no font-size, so it inherits the 16px browser
       default rather than the 19px of govuk-body. The govuk-!-font-weight-bold
       is required because govuk-body-s sets font-weight:400, which would
       otherwise strip the h2's bold. #}
    <h2 class="govuk-body-s govuk-!-font-weight-bold">{{ createAccountText }}</h2>

    <p class="govuk-body-s">
      <a href="/create-media-account" class="govuk-link">{{ createAccountLink }}</a>
    </p>

    <p class="govuk-body-s">
      <strong>{{ userResearchText }}</strong>
    </p>

  </div>
</div>
{% endblock %}
