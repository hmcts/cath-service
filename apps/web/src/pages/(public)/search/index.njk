{% extends "layouts/base-template.njk" %}
{% from "govuk/components/label/macro.njk" import govukLabel %}
{% from "govuk/components/hint/macro.njk" import govukHint %}
{% from "govuk/components/error-message/macro.njk" import govukErrorMessage %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block page_content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if errors %}
      {{ govukErrorSummary({
        titleText: errorSummaryTitle,
        errorList: errors
      }) }}
    {% endif %}

    <h1 class="govuk-heading-l">{{ title }}</h1>

    <form method="post" novalidate data-replace-history-on-error>
      {#- Built by hand rather than with govukInput: the agreed design puts the
          inline error above the hint, and govukInput always renders the hint first. -#}
      <div class="govuk-form-group{% if errors %} govuk-form-group--error{% endif %}">
        {{ govukLabel({
          text: "Search",
          classes: "govuk-visually-hidden",
          for: "location"
        }) }}
        {% if errors %}
          {{ govukErrorMessage({
            id: "location-error",
            text: errors[0].text
          }) }}
        {% endif %}
        {{ govukHint({
          id: "location-hint",
          text: searchHint
        }) }}
        <input class="govuk-input{% if errors %} govuk-input--error{% endif %}" id="location" name="locationId" type="text"
          value="{{ ((preselectedLocation.welshName if locale === "cy" else preselectedLocation.name) if preselectedLocation else "") }}"
          aria-describedby="{{ "location-error location-hint" if errors else "location-hint" }}"
          data-location-id="{{ preselectedLocation.id if preselectedLocation else "" }}"
          data-autocomplete="true"
          data-locale="{{ locale }}"
          data-no-results-message="{{ noResultsFound }}">
      </div>

      {{ govukButton({
        text: continueButton
      }) }}
    </form>

    <p class="govuk-body">
      <a href="/courts-tribunals-list" class="govuk-link">{{ azListLink }}</a>
    </p>

  </div>
</div>
{% endblock %}
