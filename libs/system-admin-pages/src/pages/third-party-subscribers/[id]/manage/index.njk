{% extends "layouts/base-template.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}

{% block backLink %}
  <a href="/third-party-subscribers{{ lngParam }}" class="govuk-back-link">{{ back }}</a>
{% endblock %}

{% block page_content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

    <form method="post" novalidate>
      {{ govukButton({
        text: testConnectionButton,
        preventDoubleClick: true
      }) }}
    </form>

    {% if connectionResult %}
      <div class="connection-result {{ 'connection-result--success' if connectionResult.isSuccess else 'connection-result--fail' }} govuk-!-margin-bottom-5" role="alert">
        <p class="govuk-body connection-result__title">{{ connectionResult.title }}</p>
        <p class="govuk-body">{{ connectionResult.message }}</p>
        {% if connectionResult.reason %}
          <p class="govuk-body">{{ connectionTest.reasonLabel }}: {{ connectionResult.reason }}</p>
        {% endif %}
      </div>
    {% endif %}

    {{ govukSummaryList({
      rows: [
        {
          key: { text: tableHeadings.name },
          value: { text: name }
        },
        {
          key: { text: tableHeadings.createdDate },
          value: { text: createdAt }
        },
        {
          key: { text: tableHeadings.subscriptionCount },
          value: { text: subscriptionCount }
        }
      ]
    }) }}

    <div class="govuk-button-group">
      {{ govukButton({
        text: manageSubscriptionsButton,
        href: "/third-party-subscribers/" + userId + "/subscriptions/manage" + lngParam
      }) }}

      {{ govukButton({
        text: manageOauthConfigButton,
        href: "/third-party-subscribers/" + userId + "/oauth-config" + lngParam
      }) }}

      {{ govukButton({
        text: deleteUserButton,
        href: "/third-party-subscribers/" + userId + "/delete/confirmation" + lngParam,
        classes: "govuk-button--warning"
      }) }}
    </div>

  </div>
</div>
{% endblock %}
