{
  "name": "@hmcts/legacy-migration",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "production": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@azure/identity": "4.10.0",
    "@azure/keyvault-secrets": "4.11.2",
    "@azure/storage-blob": "12.27.0",
    "@hmcts/azure-blob": "workspace:*",
    "@hmcts/list-types-common": "workspace:*",
    "@hmcts/location": "workspace:*",
    "@hmcts/postgres-prisma": "workspace:*",
    "@hmcts/publication": "workspace:*",
    "@hmcts/third-party-user": "workspace:*",
    "pg": "8.21.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe ."
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "typescript": "6.0.3"
  }
}
